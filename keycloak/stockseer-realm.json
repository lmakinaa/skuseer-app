{
  "realm": "stockseer",
  "enabled": true,
  "displayName": "StockSeer",
  "loginTheme": "stockseer",
  "accountTheme": "stockseer",
  "emailTheme": "stockseer",
  "sslRequired": "external",
  "registrationAllowed": false,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "resetPasswordAllowed": true,
  "editUsernameAllowed": false,
  "bruteForceProtected": true,
  "accessTokenLifespan": 300,
  "ssoSessionIdleTimeout": 604800,
  "ssoSessionMaxLifespan": 604800,
  "offlineSessionIdleTimeout": 604800,
  "offlineSessionMaxLifespan": 604800,
  "revokeRefreshToken": true,

  "roles": {
    "realm": [
      {
        "name": "platform_admin",
        "description": "Platform-level administrator with access to the back-office"
      },
      {
        "name": "default-roles-stockseer",
        "description": "Default role for all users",
        "composite": false
      }
    ]
  },

  "defaultDefaultClientScopes": [
    "openid",
    "profile",
    "email"
  ],

  "clients": [
    {
      "clientId": "stockseer-frontend",
      "name": "StockSeer Frontend",
      "enabled": true,
      "publicClient": true,
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "implicitFlowEnabled": false,
      "serviceAccountsEnabled": false,
      "protocol": "openid-connect",
      "rootUrl": "http://localhost:8080",
      "baseUrl": "http://localhost:8080",
      "redirectUris": [
        "http://localhost:8080/*",
        "https://demo.skuseer.com/*"
      ],
      "webOrigins": [
        "http://localhost:8080",
        "https://demo.skuseer.com"
      ],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "http://localhost:8080/*##https://demo.skuseer.com/*"
      },
      "defaultClientScopes": [
        "openid",
        "profile",
        "email",
        "roles",
        "web-origins"
      ]
    }
  ],

  "identityProviders": [
    {
      "alias": "google",
      "providerId": "google",
      "enabled": false,
      "trustEmail": true,
      "firstBrokerLoginFlowAlias": "first broker login",
      "config": {
        "clientId": "GOOGLE_CLIENT_ID_PLACEHOLDER",
        "clientSecret": "GOOGLE_CLIENT_SECRET_PLACEHOLDER",
        "defaultScope": "openid profile email",
        "syncMode": "IMPORT"
      }
    },
    {
      "alias": "microsoft",
      "displayName": "Azure AD",
      "providerId": "microsoft",
      "enabled": false,
      "trustEmail": true,
      "firstBrokerLoginFlowAlias": "first broker login",
      "config": {
        "clientId": "AZURE_CLIENT_ID_PLACEHOLDER",
        "clientSecret": "AZURE_CLIENT_SECRET_PLACEHOLDER",
        "defaultScope": "openid profile email",
        "syncMode": "IMPORT"
      }
    }
  ],

  "users": [
    {
      "username": "demo",
      "email": "demo@stockseer.local",
      "firstName": "Demo",
      "lastName": "User",
      "enabled": true,
      "emailVerified": true,
      "credentials": [
        {
          "type": "password",
          "value": "demo123",
          "temporary": false
        }
      ],
      "realmRoles": [
        "default-roles-stockseer",
        "platform_admin"
      ]
    }
  ]

}
