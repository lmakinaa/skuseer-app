# Database
DATABASE_URL=sqlite:///./stockseer.db

# Keycloak
# KEYCLOAK_URL: used for backend->keycloak HTTP calls (JWKS fetch).
# In Docker, set to http://keycloak:8080 (service name on the internal network).
KEYCLOAK_URL=http://localhost:8180
# KEYCLOAK_ISSUER_URL: used to validate the `iss` claim in tokens. Must match
# what the BROWSER used when obtaining the token. Leave unset to default to
# KEYCLOAK_URL (correct for non-docker local dev).
# KEYCLOAK_ISSUER_URL=http://localhost:8180
KEYCLOAK_REALM=stockseer
KEYCLOAK_CLIENT_ID=stockseer-frontend

# SMTP (Zoho)
SMTP_HOST=smtp.zoho.com
SMTP_PORT=587
SMTP_USER=your-email@yourdomain.com
SMTP_PASSWORD=your-app-password
SMTP_FROM=noreply@yourdomain.com

# App
APP_URL=http://localhost:8080
